# ─────────────────────────────────────────────
# yt-dlp / ffmpeg (binaires système)
# Chemin du binaire yt-dlp (défaut : "yt-dlp" dans le PATH)
YTDLP_PATH="yt-dlp"
# Dossier contenant ffmpeg.exe / ffprobe (défaut : cherché dans le PATH)
# Windows (winget) : C:\Users\<vous>\AppData\Local\Microsoft\WinGet\Links
# Linux/macOS    : /usr/bin
FFMPEG_PATH=""
# Optionnel : fichier de cookies pour YouTube (format Netscape)
# YTDLP_COOKIES=""

# Deezer : relais de secours si l'API est bloquée (VPN, WARP, IP datacenter).
# Valeur par défaut : https://r.jina.ai/ · Mettre "off" pour désactiver.
# DEEZER_PROXY="https://r.jina.ai/"

# ─────────────────────────────────────────────
# Front statique (InfinityFree, Netlify, GitHub Pages…)
# URL publique du serveur Node qui exécute yt-dlp/ffmpeg.
# Laisser vide en local : les appels partent vers /api/... sur la même origine.
# NEXT_PUBLIC_API_BASE="https://mon-api.exemple.com"
