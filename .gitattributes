# Normalise les fins de ligne : indispensable pour le Dockerfile et les scripts
# exécutés sur Linux (Render/Docker), même si le dépôt est cloné sous Windows.
* text=auto
Dockerfile text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
